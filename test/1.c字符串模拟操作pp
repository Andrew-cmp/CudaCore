#include <iostream>
#include<bits/stdc++.h>
using namespace std;
int main() {
    int m , n;
    cin >> n >> m;
    string s;
    cin >> s;
    unordered_map<char,int> map;
    for(int i = 0;i < m;i++){
        int op;
        char l1, l2;
        cin >> op;
        cin >> l1;
        cin >> l2;
        for(int i = 0; l1+i<=l2;i++){
            map[(char)tolower(l1+i)] = op;
        }
    }
    for(int i = 0;i <n;i++){
        if(map.count((char)tolower(s[i]))){
            if(map[(char)tolower(s[i])] == 1){
                cout << (char)toupper(s[i]);
            }else{
                cout << (char)tolower(s[i]);
            }
        }
        else cout << s[i];
    }
}
